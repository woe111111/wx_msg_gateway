<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.mdnode.wecomprobe"
    android:versionCode="7"
    android:versionName="0.7">
    <uses-sdk android:minSdkVersion="25" android:targetSdkVersion="35" />
    <queries><package android:name="com.tencent.wework" /></queries>
    <application android:allowBackup="false" android:debuggable="true" android:label="企微只读探针"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".ProbeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".ProbeService" android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/probe_service" />
        </service>
    </application>
</manifest>
