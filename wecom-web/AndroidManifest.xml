<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.mdnode.wecomweb" android:versionCode="20" android:versionName="1.8">
    <uses-sdk android:minSdkVersion="25" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <queries><package android:name="com.tencent.wework" /></queries>
    <application android:allowBackup="false" android:usesCleartextTraffic="true" android:label="企微网页收发"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name="local.mdnode.wecomprobe.WeComWebActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name="local.mdnode.wecomprobe.WeComWebService" android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/wecom_web_service" />
        </service>
    </application>
</manifest>
